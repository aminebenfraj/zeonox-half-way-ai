# AI providers
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Dashboard and launcher networking
HOST=127.0.0.1
APPROVAL_SERVER_PORT=8799
APPROVAL_SERVER_URL=http://127.0.0.1:8799
CONTROL_SERVER_PORT=8800
LAUNCHER_CONTROL_URL=http://127.0.0.1:8800

# Optional HTTP Basic Auth (set both or leave both blank)
APPROVAL_USER=
APPROVAL_PASS=

# iPhone/Home Screen Web Push notifications
VAPID_PRIVATE_KEY=secrets/private_key.pem
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_SUBSCRIPTIONS_FILE=.push_subscriptions.json

# Tailscale Serve: private tailnet access only
TAILSCALE_EXE=C:\Program Files\Tailscale\tailscale.exe
TAILSCALE_SERVE_TARGET=http://127.0.0.1:8799
TAILSCALE_DNS_NAME=your-pc.your-tailnet.ts.net
TAILSCALE_DASHBOARD_URL=https://your-pc.your-tailnet.ts.net

# Chameleon-AI login
CHAMELEON_EMAIL=
CHAMELEON_PASSWORD=

# Platform logins
