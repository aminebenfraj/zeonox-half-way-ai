# AI providers
GROQ_API_KEY=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Dashboard and launcher networking
HOST=127.0.0.1
APPROVAL_SERVER_PORT=8799
APPROVAL_SERVER_URL=http://127.0.0.1:8799
# Durable approval queue/history database. Relative paths are resolved from
# the process working directory; the default is secrets/approval_state.sqlite3.
APPROVAL_DB_PATH=secrets/approval_state.sqlite3
# Notify once when a pending approval reaches this age (seconds).
APPROVAL_ALERT_AFTER_SECONDS=600
# Number of launcher crashes that marks a bot as being in a crash loop.
CRASH_LOOP_THRESHOLD=3
# Avoid false stale alerts while bots send their first heartbeat after a
# dashboard restart.
HEALTH_STARTUP_GRACE_SECONDS=90
# Waiting bots normally report every 30 seconds; 75 seconds avoids jitter-based
# false positives while still detecting a genuinely stuck worker quickly.
BOT_HEARTBEAT_STALE_SECONDS=75
CONTROL_SERVER_PORT=8800
LAUNCHER_CONTROL_URL=http://127.0.0.1:8800

# Optional HTTP Basic Auth (set both or leave both blank)
APPROVAL_USER=
APPROVAL_PASS=

# iPhone/Home Screen Web Push notifications
VAPID_PRIVATE_KEY=secrets/private_key.pem
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_SUBSCRIPTIONS_FILE=.push_subscriptions.json

# Tailscale Serve: private tailnet access only
TAILSCALE_EXE=C:\Program Files\Tailscale\tailscale.exe
TAILSCALE_SERVE_TARGET=http://127.0.0.1:8799
TAILSCALE_DNS_NAME=your-pc.your-tailnet.ts.net
TAILSCALE_DASHBOARD_URL=https://your-pc.your-tailnet.ts.net

# Chameleon-AI login
CHAMELEON_EMAIL=
CHAMELEON_PASSWORD=

# Platform logins
JUSTLO_FR_USERNAME=
JUSTLO_FR_PASSWORD=
# Exact Chameleon chat label used for the French workflow.
JUSTLO_FR_CHAMELEON_CHAT=Justlo FR
DIAMOND_USERNAME=
DIAMOND_PASSWORD=
S69_USERNAME=
S69_PASSWORD=
GOLD_USERNAME=
GOLD_PASSWORD=
GOLD2_USERNAME=
GOLD2_PASSWORD=
GOLD3_USERNAME=
GOLD3_PASSWORD=
PLATIN_USERNAME=
PLATIN_PASSWORD=
ML_USERNAME=
ML_PASSWORD=
XKUSS_USERNAME=
XKUSS_PASSWORD=
JUSTLO_USERNAME=
JUSTLO_PASSWORD=
LINDUU_USERNAME=
LINDUU_PASSWORD=
LINDUU_US_USERNAME=
LINDUU_US_PASSWORD=
GNOXX_USERNAME=
GNOXX_PASSWORD=
